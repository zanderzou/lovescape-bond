---
import{getCollection}from"astro:content";import BaseLayout from"../../layouts/BaseLayout.astro";import PostCard from"../../components/PostCard.astro";import{site}from"../../data/site";const posts=(await getCollection("blog")).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf());const jsonLd={"@context":"https://schema.org","@type":"CollectionPage",name:"Lovescape comparisons and safety guides",url:`${site.url}/blog/`,description:"Independent Lovescape comparisons, Chip explainers, safety checklists, and AI companion studio research.",hasPart:posts.map((post)=>({"@type":"Article",headline:post.data.title,url:`${site.url}/blog/${post.id}/`,datePublished:post.data.publishDate.toISOString()}))};
---
<BaseLayout title="Lovescape Journal: Reviews, Comparisons & Safety" description="Independent Lovescape guides covering AI companions, custom characters, chat, images, video, voice, Chips, pricing, privacy, Candy AI, OurDream AI, and alternatives." keywords={["Lovescape blog","Lovescape review","Lovescape comparison","AI companion alternatives","Lovescape safety"]} jsonLd={jsonLd}><section class="page-hero"><div class="ambient-orb"></div><span>LOVESCAPE RESEARCH JOURNAL</span><h1>One character.<br/>Every decision documented.</h1><p>Original guides for Lovescape and the wider AI companion studio category—written for adults who want clear media, privacy, consent, and cost tradeoffs.</p></section><section class="section blog-list"><div class="post-grid">{posts.map((post,index)=><PostCard post={post} index={index}/>)}</div></section></BaseLayout>
