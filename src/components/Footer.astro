---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
import { site } from "../data/site";
interface Props { posts: CollectionEntry<"blog">[]; }
const { posts } = Astro.props;
---
<footer><div class="footer-grid">
  <div><a class="brand" href="/"><span class="brand-icon">LS</span><strong>Love<span>scape</span></strong></a><p>Independent research on Lovescape characters, companion chat, image and video generation, Chips, privacy, pricing, safety, and alternatives.</p></div>
  <div><h3>Explore</h3><a href="/#features">Lovescape studio</a><a href="/#compare">Companion comparisons</a><a href="/#privacy">Privacy and consent</a><a href={site.officialUrl} rel="noopener" target="_blank">Official Lovescape <Icon name="arrow" /></a><a href="https://spicy-box.com/?utm_ref=c546b6e92223b411" rel="sponsored nofollow noopener noreferrer" target="_blank">Sponsored referral: Playbox <Icon name="arrow" /></a></div>
  <div><h3>Latest comparisons</h3>{posts.slice(0,3).map((post)=><a href={`/blog/${post.id}/`}>{post.data.title}</a>)}</div>
  <div><h3>Information</h3><a href="/about/">About</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/editorial-policy/">Editorial policy</a><a href="/contact/">Contact</a></div>
</div><div class="footer-bottom"><span>© <span data-year>2026</span> Lovescape</span><span>Independent · Not affiliated with Lovescape</span><span>Adults 18+ · No chat or media collected</span></div></footer>
