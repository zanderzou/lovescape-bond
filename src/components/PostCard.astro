---
import type { CollectionEntry } from "astro:content";import Icon from"./Icon.astro";interface Props{post:CollectionEntry<"blog">;index?:number;compact?:boolean}const{post,index=0,compact=false}=Astro.props;const icons=["heart","chat","lock"]as const;
---
<article class:list={["post-card",post.data.accent]}><a href={`/blog/${post.id}/`}>{!compact&&<div class="post-visual"><span>STUDIO NOTE 0{index+1}</span><Icon name={icons[index%3]}/></div>}<div class="post-copy"><div class="post-meta"><span>{post.data.category}</span></div><h3>{post.data.title}</h3><p>{post.data.description}</p><strong>Read the comparison <Icon name="arrow"/></strong></div></a></article>
